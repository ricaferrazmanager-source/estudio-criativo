# Referência inicial; nomes sujeitos ao planejamento aprovado.
# Não preencha este arquivo versionado com credenciais reais.
# Para a interface, usar as variáveis NEXT_PUBLIC abaixo em apps/web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Uso exclusivo no servidor; nunca expor ao cliente.
SUPABASE_SECRET_KEY=
# Origem confiável: HTTPS em publicação; HTTP somente no computador local.
STUDIO_SITE_URL=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Somente se o acesso S3 for adotado; Workers podem usar bindings.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Credenciais de APIs de imagens serão definidas após escolha de provedores.
# Bindings Workers/Queues serão definidos na etapa de infraestrutura.

# Ativar somente após migrations e vínculo de equipe homologados. Vazio desativa.
STUDIO_CATALOG_ENABLED=
