# Referência inicial; nomes sujeitos ao planejamento aprovado.
# Não preencha este arquivo versionado com credenciais reais.
# Nenhuma aplicação consome estas variáveis nesta etapa.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Uso exclusivo no servidor; nunca expor ao cliente.
SUPABASE_SECRET_KEY=
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Somente se o acesso S3 for adotado; Workers podem usar bindings.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Credenciais de APIs de imagens serão definidas após escolha de provedores.
# Bindings Workers/Queues serão definidos na etapa de infraestrutura.
